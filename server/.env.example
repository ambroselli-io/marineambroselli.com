# À copier dans ~/marineambroselli-rdv/.env sur le serveur (hors du dossier servi par nginx).
PORT=3210
SITE_URL=https://marineambroselli.com

# --- Tipimail (obligatoire pour envoyer les mails) ---
TIPIMAIL_API_USER=
TIPIMAIL_API_KEY=
# L'expéditeur doit être sur un domaine vérifié dans Tipimail (SPF/DKIM de marineambroselli.com)
MAIL_FROM=rdv@marineambroselli.com
MAIL_FROM_NAME=Marine Ambroselli

# --- Marine ---
HOST_EMAIL=marine@example.com
HOST_TIMEZONE=Europe/Paris

# --- Agenda de Marine : google | caldav | none ---
CALENDAR_PROVIDER=none

# Google Agenda (crée aussi le lien Google Meet) — voir scripts/google-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# iCloud / CalDAV — mot de passe pour app généré sur appleid.apple.com
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=

# Lien visio si l'agenda n'en fournit pas ({id} = identifiant du rdv).
# Ex. salle perso fixe : VIDEO_URL_TEMPLATE=https://zoom.us/j/123456789
VIDEO_URL_TEMPLATE=https://meet.jit.si/MarineAmbroselli-{id}

# --- Règles de réservation (optionnel) ---
# MIN_NOTICE_MINUTES=120
# HORIZON_DAYS=60
# BUFFER_MINUTES=0
# WEEKLY_HOURS={"1":[["09:00","17:00"]],"2":[["09:00","17:00"]],"3":[["09:00","17:00"]],"4":[["09:00","17:00"]],"5":[["09:00","17:00"]]}
